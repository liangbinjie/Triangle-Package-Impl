package Utils ~
  func min(a: Integer, b: Integer): Integer ~
    if a < b then a else b;

  func max(a: Integer, b: Integer): Integer ~
    if a < b then b else a;

  export min, max
end;

let
  from Utils import min, max;
  const r ~ min(5, 9);
  proc main() ~
    begin
      putint(r);
      puteol()
    end
in
  main()
